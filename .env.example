# ---------------------------------------------------------------
# Gohar Group website: environment configuration
# Copy this file to `.env` and fill in values. Never commit `.env`.
# `npm run dev` works without any of these (it uses a local SQLite file).
# ---------------------------------------------------------------

# Public URL of the site, used for canonical URLs, sitemap and social cards.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Database (required in production) --------------------------------
# Local / single server with a persistent disk:
DATABASE_URL=file:./.data/gohar.db
# Managed libSQL (e.g. Turso), required on serverless hosts such as Vercel:
# DATABASE_URL=libsql://your-database-your-org.turso.io
# DATABASE_AUTH_TOKEN=

# --- Email notifications for new enquiries (optional) -----------------
# none   = don't send (enquiries are still saved and shown in /admin)
# smtp   = any SMTP server, e.g. Google Workspace for info@gohargoc.com
# resend = Resend HTTP API
EMAIL_PROVIDER=none
EMAIL_FROM="Gohar Group Website <info@gohargoc.com>"
# Comma-separated list of staff addresses that receive new enquiries.
ENQUIRY_NOTIFY_TO=info@gohargoc.com

# SMTP (when EMAIL_PROVIDER=smtp). For Google Workspace use an App Password:
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=info@gohargoc.com
# SMTP_PASS=

# Resend (when EMAIL_PROVIDER=resend). The sender domain must be verified in Resend.
# RESEND_API_KEY=

# --- Security & privacy -------------------------------------------------
# Random secret used to hash visitor IP addresses for rate limiting.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
IP_HASH_SALT=

# Days to keep enquiries before `npm run enquiries:purge` deletes them.
ENQUIRY_RETENTION_DAYS=730
# Days to keep careers applications and CVs.
CAREER_RETENTION_DAYS=365

# --- WhatsApp -------------------------------------------------------------
# Defaults to the client-supplied number +92 337 3723420 (wa.me/923373723420).
# Override with another number (digits only), or "none" to hide WhatsApp. Rebuild after changing.
# NEXT_PUBLIC_WHATSAPP_NUMBER=923373723420
