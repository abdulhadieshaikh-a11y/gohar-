{
  "name": "gohar-group-website",
  "version": "1.0.0",
  "private": true,
  "description": "Website for Gohar Group of Companies: projects, enquiries and admin dashboard.",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "predev": "node scripts/db-migrate.mjs",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "preview": "npm run build && next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm run lint && npm run test",
    "format": "prettier --write .",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node scripts/db-migrate.mjs",
    "db:seed": "node scripts/db-seed.mjs",
    "admin:create": "node scripts/create-admin.mjs",
    "enquiries:purge": "node scripts/purge-enquiries.mjs",
    "images:optimize": "node scripts/optimize-images.mjs",
    "images:plan": "tsx scripts/image-usage.ts",
    "assets:manifest": "tsx scripts/generate-asset-manifest.ts",
    "icons:generate": "node scripts/generate-icons.mjs",
    "assets:import": "node scripts/import-official-media.mjs",
    "assets:fetch": "powershell -ExecutionPolicy Bypass -File scripts/fetch-official-assets.ps1"
  },
  "dependencies": {
    "@libsql/client": "^0.18.0",
    "drizzle-orm": "^0.45.4",
    "lenis": "1.3.11",
    "lucide-react": "^1.61.0",
    "next": "16.4.2",
    "nodemailer": "^10.2.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^24.19.2",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "prettier": "^3.9.10",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.5"
  }
}
